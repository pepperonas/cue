<?xml version="1.0" encoding="utf-8"?>
<!--
  Vordergrund des adaptiven Symbols, aus `frontend/public/favicon.svg`
  übertragen (Warteschlangen-Zeilen + Blitz — "cue = queue lines + bolt").

  Die Original-SVG ist 32×32; ihr Motiv (ohne Kachel-Hintergrund und
  Rahmen, die hier über `ic_launcher_background.xml` bzw. das System
  kommen) liegt bei x 5,75–25,8 / y 5,5–26,5 (inkl. der runden Stroke-Caps).
  Skaliert ×2,25 (= 72/32, die innere Schutzzone eines 108×108-Viewports)
  und um (18,18) verschoben — exakt der Rand der 72×72-Zone — landet das
  Motiv bei x 30,9–76,1 / y 30,4–77,6: vollständig innerhalb 18–90 in
  beiden Achsen, mit ~12–14 px Luft auf jeder Seite. Die Gruppen-Transform
  wirkt dabei auch auf `strokeWidth` (wie in SVG), das Verhältnis
  Strichbreite↔Motivgröße bleibt also exakt wie im Original.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.25"
        android:scaleY="2.25"
        android:translateX="18"
        android:translateY="18">
        <!-- Warteschlange: der nächste Prompt am hellsten, der Rest verblasst -->
        <path
            android:pathData="M7,10 L13.5,10"
            android:strokeColor="#A78BFA"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeAlpha="0.95" />
        <path
            android:pathData="M7,16 L12,16"
            android:strokeColor="#A78BFA"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeAlpha="0.55" />
        <path
            android:pathData="M7,22 L10.5,22"
            android:strokeColor="#A78BFA"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeAlpha="0.3" />
        <!-- Blitz: Ausführung -->
        <path
            android:pathData="M23.4,5.5 L14.8,17.3 H19.6 L16.6,26.5 L25.8,13.9 H20.6 Z"
            android:fillColor="#A78BFA" />
    </group>
</vector>
