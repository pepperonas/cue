<?xml version="1.0" encoding="utf-8"?>
<!--
  Nur im Debug-Build: erlaubt Klartext-HTTP, damit `SettingsScreen` gegen einen
  lokalen Dev-Server (z. B. `http://10.0.2.2:8010` im Emulator) verbinden kann.
  `core/ServerUrl.kt:normalizeServerUrl` lässt http:// ohnehin nur für lokale
  Adressen zu — ohne diese Konfiguration blockt Android das trotzdem auf
  Netzwerk-Ebene (Cleartext standardmäßig verboten seit API 28), unabhängig
  von der App-eigenen Prüfung. Release-Builds bekommen diese Datei NIE
  (source set `debug`), Produktion bleibt auf https:// beschränkt.

  Fix-Runde 1, Regel 10: `domain-config` statt `base-config` — die vorherige
  Fassung erlaubte Klartext für JEDEN Host, nicht nur die drei lokalen
  Adressen, die `normalizeServerUrl` überhaupt zulässt (10.0.2.2 = Emulator,
  localhost/127.0.0.1 = derselbe Rechner). `normalizeServerUrl`s Regex kennt
  darüber hinaus auch private LAN-Bereiche (10.x/192.168.x/172.16-31.x) für
  einen Test gegen einen echten Dev-Server im Heimnetz — eine `domain-config`
  kennt aber nur feste Hostnamen/Adressen, keine CIDR-Bereiche; diese drei
  decken den Emulator-Fall ab, den diese App-Sitzung tatsächlich brauchte.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
